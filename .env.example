# Copy this file to .env. Never commit the real API key.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173

# Basic single-process protection. Put a reverse proxy/CDN rate limit in front
# of the public production service as traffic grows.
ADMIN_LOGIN_LIMIT_PER_15_MIN=10
ANALYZE_LIMIT_PER_HOUR=20

# DeepSeek V4 Flash handles webpage text and final structured extraction.
COLLECTOR_AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
COLLECTOR_AI_API_KEY=replace-with-dashscope-key
COLLECTOR_AI_MODEL=deepseek-v4-flash
COLLECTOR_AI_JSON_MODE=true
COLLECTOR_AI_ENABLE_THINKING=true

# Optional search-planning LLM. It generates cached keyword variants only;
# source discovery and programme matching remain deterministic.
COLLECTOR_SEARCH_AI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
COLLECTOR_SEARCH_AI_API_KEY=replace-with-dashscope-key
COLLECTOR_SEARCH_AI_MODEL=qwen-plus
COLLECTOR_SEARCH_AI_JSON_MODE=true
COLLECTOR_SEARCH_AI_TIMEOUT_MS=30000

# Optional image-reading fallback for image-heavy case pages (Qwen3.8-Max)
COLLECTOR_OCR_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
COLLECTOR_OCR_API_KEY=replace-with-dashscope-key
COLLECTOR_OCR_MODEL=qwen3.8-max
COLLECTOR_OCR_ENABLE_THINKING=false
COLLECTOR_OCR_TIMEOUT_MS=240000
COLLECTOR_OCR_MODE=fallback
COLLECTOR_OCR_TEXT_THRESHOLD=5000

# Independent second pass used only when year/GPA/language looks suspicious.
# It intentionally uses a different OCR model from the primary vision reader.
COLLECTOR_VERIFY_MODEL=qwen3.5-ocr
COLLECTOR_VERIFY_TIMEOUT_MS=120000

# Optional semantic vector retrieval for approved cases. The endpoint must be
# an OpenAI-compatible embeddings endpoint; new approved cases are indexed by
# `npm run collector:build-embeddings`.
VECTOR_SEARCH_ENABLED=false
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_API_KEY=replace-with-dashscope-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_MS=60000

# Required to open /review.html and the collection controls.
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_TTL_MS=28800000

# 0 means low-case projects still enter the second-layer AI analysis.
MIN_APPROVED_CASES=0
